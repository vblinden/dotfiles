# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="groknight"

plugins=(git)

source $ZSH/oh-my-zsh.sh

# Resolve dotfiles root (install symlinks home/zshrc -> this file)
if [[ -L "$HOME/.zshrc" ]]; then
  DOTFILES="$(cd "$(dirname "$(readlink "$HOME/.zshrc")")/.." && pwd)"
else
  DOTFILES="${DOTFILES:-$HOME/Code/vblinden/dotfiles}"
fi

# Core shell config (split for clarity)
[[ -f "$DOTFILES/zsh/exports.zsh" ]] && source "$DOTFILES/zsh/exports.zsh"
[[ -f "$DOTFILES/zsh/aliases.zsh" ]] && source "$DOTFILES/zsh/aliases.zsh"
[[ -f "$DOTFILES/zsh/functions.zsh" ]] && source "$DOTFILES/zsh/functions.zsh"

# Secrets (never committed)
if [[ -f ~/.secrets ]]; then
  source ~/.secrets
fi

# Machine-local overrides (not committed)
# Create ~/.dotfiles-custom/shell/{exports,aliases,functions,zshrc}.zsh as needed
for file in ~/.dotfiles-custom/shell/{exports,aliases,functions,zshrc}.zsh; do
  [[ -r "$file" ]] && source "$file"
done

# Platform paths
if [[ $(uname) == "Darwin" ]]; then
  export PATH="/opt/homebrew/bin:$PATH"
  export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"
  export PATH="/opt/homebrew/opt/ruby/bin:/usr/local/lib/ruby/gems/3.1.0/bin:$PATH"
  export PATH="/opt/homebrew/opt/python@3.11/bin:$PATH"
elif command -v apt >/dev/null; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
else
  echo 'Unknown OS!'
fi

# FNM (fast node manager)
if command -v fnm &>/dev/null; then
  eval "$(fnm env --use-on-cd)"
fi

# Zoxide (smart cd)
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
fi

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
# <<< grok installer <<<
