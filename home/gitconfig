[user]
  name = "vblinden"
  email = "hello@vblinden.dev"

[includeif "gitdir:~/Code/teamblue/"]
  path = ~/Code/teamblue/.gitconfig

[url "git@github.com:"]
	insteadOf = https://github.com/

[init]
	defaultBranch = master

[push]
	autoSetupRemote = true

[core]
	editor = nvim
	excludesfile = ~/.gitignore
	ignorecase = false
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true

[pull]
	rebase = true

[rebase]
	autoStash = true

[merge]
	autoStash = true
	conflictstyle = diff3
	tool = nvimdiff

[rerere]
	enabled = true
