shell-integration-features = cursor
font-family = JetBrains Mono
# background-opacity = 0.85
# background-blur-radius = 85
# background = 000000
font-size = 16
font-feature = -calt
# adjust-cell-height = 12%
# adjust-cell-width = -1
term = xterm-256color
adjust-cursor-thickness = 4
# Cursor colors live in the theme files so light and dark can differ.
theme = dark:Grok Dark,light:Grok Light
window-padding-x = 0
window-padding-y = 0
confirm-close-surface = false
copy-on-select = clipboard
title = " "
macos-titlebar-proxy-icon = hidden
bell-features = no-system,no-title
progress-style = false

# shift+enter -> CSI-u extended key sequence.
# Sent through tmux (extended-keys on, csi-u format) so coding agents
# (e.g. OpenCode) can treat shift+enter as newline instead of submit.
keybind = shift+enter=text:\x1b[13;2u
